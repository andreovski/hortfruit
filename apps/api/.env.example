# Postgres local: `docker compose up -d` na raiz.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hortifruit?schema=public"
# Banco dos e2e (o nome precisa terminar em _test; o setup apaga e recria).
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/hortifruit_test?schema=public"
PORT=3333
# Interface em que a API escuta.
HOST="0.0.0.0"
# Origens aceitas pelo CORS, separadas por vírgula (o dev do Vite).
FRONTEND_URL="http://localhost:5173"
# Endereço público do app (o web). O UploadThing chama ${APP_URL}/api/uploadthing.
APP_URL="http://localhost:5173"
# Atrás do proxy do Railway.
TRUST_PROXY=false

# Obrigatória em produção. Gere com: openssl rand -hex 32
JWT_SECRET=""

# Primeiro ADM do painel: o seed cria se ainda não houver nenhum (e-mail e/ou telefone).
# A senha só vale na criação; os outros ADMs são cadastrados em Ajustes.
OWNER_NAME="André"
OWNER_EMAIL="voce@exemplo.com"
OWNER_PHONE=""
OWNER_PASSWORD="troque-esta-senha"

# WhatsApp da Morro Verde (só dígitos, com DDD). Sem ele, os botões de WhatsApp somem.
WHATSAPP_NUMBER=""

# Fotos dos produtos (uploadthing.com › API Keys › V7). Sem ele, o painel esconde o envio e o ADM
# escolhe uma das ilustrações.
UPLOADTHING_TOKEN=""

# Desliga o limite de tentativas da identificação e do envio de pedido (30 por IP a cada 10 min).
DISABLE_RATE_LIMIT=false
